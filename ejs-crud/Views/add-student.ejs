<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add-Student</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <center>
        <h1 style="color: rgb(153, 153, 142);">Add-student</h1>
        <form action="/add-student/" method="post">
            <input type="text" name="name" id="name" placeholder="enter name"><br><br>
            <input type="email" name="email" id="email" placeholder="enter eamil"><br><br>
            <input type="text" name="phone" id="phone" placeholder="enter phone"><br><br>
            <input type="text" name="course" id="course" placeholder="enter course"><br><br>
              <input type="submit" value="Submit" id="btn">
              <input type="reset" value="Cancel"  id="btn">

        </form>
    </center>
    
</body>
</html>