<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show student details!</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <center>
        <h1>Student Details</h1>
        <form method="post">
           <table  border="2">
            <tr><th>name</th><td><%=stu.name%></td></tr>
              <tr><th>email</th><td><%=stu.email%></td></tr>
                <tr><th>phone</th><td><%=stu.phone%></td></tr>
                 <tr><th>course</th><th><%=stu.course%></th></tr>
                 
            <tr  id="show">
                <td colspan="2">
               <a href="/edit-student/<%=stu._id%>">Edit</a>
               <a href="/delete-student/<%=stu._id%>"
                onclick="javascript: return confirm('are you sure delete!')">Delete</a>
               <a href="javascript:window.print()">Print</a>
                <a href="/">Cancel</a>
            </td></tr>      
              
        </table>
        </form>

    </center>
    
</body>
</html>